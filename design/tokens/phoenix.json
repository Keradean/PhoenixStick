{
  "name": "Phönix",
  "id": "phoenix",
  "default": true,
  "reference": "1920x1080 px",
  "description": "Standard-Theme im Kino-Look: Tiefschwarz, Kino-Rot, hohe schmale Titel",
  "color": {
    "background": "#0B0A0A",
    "rail": "#0B0A0A",
    "railBorder": "rgba(255,255,255,0.06)",
    "heroCard": "#120F0F",
    "surface": "#151212",
    "surfaceFocus": "#1C1615",
    "surfaceRaised": "#1C1817",
    "borderSubtle": "rgba(255,255,255,0.08)",
    "borderChip": "rgba(255,255,255,0.14)",
    "borderStrong": "rgba(255,255,255,0.25)",
    "textPrimary": "#F2EDEA",
    "textSecondary": "#D8CFCB",
    "textTile": "#E4DCD8",
    "textMuted": "#A39A96",
    "accent": "#E5322D",
    "accentSoft": "rgba(229,50,45,0.12)",
    "ember": "#FF8A70",
    "focusGlow": "rgba(229,50,45,0.45)",
    "focusRingButton": "#F2EDEA",
    "buttonPrimaryBg": "#E5322D",
    "buttonPrimaryText": "#FFFFFF"
  },
  "font": {
    "display": {
      "family": "Antonio",
      "weights": [
        300,
        400,
        600
      ],
      "license": "SIL Open Font License 1.1"
    },
    "body": {
      "family": "Manrope",
      "weights": [
        400,
        600,
        700
      ],
      "license": "SIL Open Font License 1.1"
    }
  },
  "type": {
    "wordmark": {
      "font": "display",
      "size": 40,
      "weight": 400,
      "letterSpacingEm": 0.06,
      "uppercase": true,
      "suffix": ".",
      "suffixColor": "accent"
    },
    "tab": {
      "font": "body",
      "size": 18,
      "weight": 600,
      "letterSpacingEm": 0.18,
      "uppercase": true
    },
    "clock": {
      "font": "display",
      "size": 40,
      "weight": 400,
      "tabular": true
    },
    "eyebrow": {
      "font": "body",
      "size": 18,
      "weight": 700,
      "letterSpacingEm": 0.2,
      "uppercase": true,
      "color": "accent"
    },
    "heroTitle": {
      "font": "display",
      "size": 132,
      "weight": 300,
      "lineHeight": 0.95,
      "letterSpacingEm": 0.02,
      "uppercase": true
    },
    "heroSub": {
      "font": "body",
      "size": 26,
      "weight": 400,
      "color": "textSecondary"
    },
    "heroMeta": {
      "font": "body",
      "size": 18,
      "weight": 400,
      "letterSpacingEm": 0.06,
      "uppercase": true,
      "color": "textMuted"
    },
    "button": {
      "font": "body",
      "size": 20,
      "weight": 700,
      "letterSpacingEm": 0.16,
      "uppercase": true
    },
    "sectionTitle": {
      "font": "display",
      "size": 30,
      "weight": 400,
      "letterSpacingEm": 0.16,
      "uppercase": true
    },
    "viewAll": {
      "font": "body",
      "size": 16,
      "weight": 700,
      "letterSpacingEm": 0.16,
      "uppercase": true,
      "color": "textMuted"
    },
    "tileLabel": {
      "font": "display",
      "size": 34,
      "weight": 400,
      "letterSpacingEm": 0.08,
      "uppercase": true
    },
    "tileLabelFocused": {
      "font": "display",
      "size": 38,
      "weight": 400
    },
    "tag": {
      "font": "body",
      "size": 13,
      "weight": 700,
      "letterSpacingEm": 0.12,
      "uppercase": true
    },
    "chip": {
      "font": "body",
      "size": 16,
      "weight": 700,
      "letterSpacingEm": 0.16,
      "uppercase": true
    }
  },
  "shape": {
    "railItemRadius": 16,
    "railActiveIndicator": {
      "width": 4,
      "height": 44
    },
    "heroCardRadius": 22,
    "tileRadius": 16,
    "buttonRadius": 12,
    "chipRadius": 30,
    "avatarRadius": 32
  },
  "focus": {
    "tileBorderWidth": 2,
    "tileBorderColor": "accent",
    "tileGlow": "0 0 36 focusGlow",
    "tileScale": 1.05,
    "buttonRing": {
      "width": 4,
      "color": "focusRingButton"
    },
    "buttonGlow": "0 0 40 rgba(229,50,45,0.5)"
  },
  "style": {
    "tileShape": "rounded",
    "focusStyle": "glowBorder",
    "buttonShape": "rounded",
    "labelCase": "upper",
    "hasBackgroundGrid": false
  },
  "motion": {
    "focusMs": 150,
    "heroCrossfadeMs": 200,
    "maxMs": 300,
    "easing": "ease-out"
  },
  "heroImage": {
    "type": "vector",
    "file": "design/referenz/phoenix-hero.svg",
    "note": "roter Mond, Federbögen, feiner Regen, Glutfunken"
  }
}