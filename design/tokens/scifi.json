{
  "name": "Sci-Fi (Arbeitstitel)",
  "id": "scifi",
  "default": false,
  "description": "Holo-Oberfläche auf einem Raumschiff: Nachtblau, Cyan, feine Linien, eckige Formen, Mono-Schrift",
  "font": {
    "display": {
      "family": "Chakra Petch",
      "weights": [
        500,
        600,
        700
      ],
      "license": "SIL Open Font License 1.1"
    },
    "body": {
      "family": "IBM Plex Mono",
      "weights": [
        400,
        500
      ],
      "license": "SIL Open Font License 1.1"
    },
    "mono": {
      "family": "IBM Plex Mono",
      "weights": [
        400,
        500
      ],
      "license": "SIL Open Font License 1.1"
    }
  },
  "color": {
    "background": "#060A11",
    "rail": "#07101A",
    "railBorder": "rgba(79,227,255,0.25)",
    "heroCard": "rgba(6,10,17,0.72)",
    "surface": "rgba(79,227,255,0.05)",
    "surfaceRaised": "rgba(79,227,255,0.10)",
    "surfaceFocus": "rgba(79,227,255,0.14)",
    "borderSubtle": "rgba(79,227,255,0.30)",
    "borderChip": "rgba(79,227,255,0.35)",
    "borderStrong": "rgba(79,227,255,0.50)",
    "grid": "rgba(79,227,255,0.06)",
    "textPrimary": "#E8F6FF",
    "textSecondary": "#CFE3F2",
    "textTile": "#CFE3F2",
    "textMuted": "#8FA3B8",
    "accent": "#4FE3FF",
    "accentSoft": "rgba(79,227,255,0.12)",
    "focusGlow": "rgba(79,227,255,0.45)",
    "focusRingButton": "#FFFFFF",
    "focusBrackets": "#FFFFFF",
    "buttonPrimaryBg": "#4FE3FF",
    "buttonPrimaryText": "#04121A"
  },
  "type": {
    "wordmark": {
      "font": "display",
      "size": 36,
      "weight": 700,
      "letterSpacingEm": 0.12,
      "uppercase": true,
      "suffix": "_",
      "suffixColor": "accent"
    },
    "tab": {
      "font": "mono",
      "size": 18,
      "weight": 500,
      "letterSpacingEm": 0.2,
      "uppercase": true
    },
    "clock": {
      "font": "mono",
      "size": 42,
      "weight": 500,
      "letterSpacingEm": 0,
      "uppercase": false,
      "tabular": true
    },
    "date": {
      "font": "mono",
      "size": 20,
      "weight": 400,
      "letterSpacingEm": 0.12,
      "uppercase": false,
      "color": "textMuted"
    },
    "eyebrow": {
      "font": "mono",
      "size": 20,
      "weight": 400,
      "letterSpacingEm": 0.2,
      "uppercase": true,
      "color": "accent",
      "prefix": "// "
    },
    "heroTitle": {
      "font": "display",
      "size": 112,
      "weight": 700,
      "letterSpacingEm": 0.01,
      "uppercase": true,
      "lineHeight": 1.0
    },
    "heroSub": {
      "font": "mono",
      "size": 24,
      "weight": 400,
      "letterSpacingEm": 0,
      "uppercase": false,
      "color": "textSecondary"
    },
    "heroMeta": {
      "font": "mono",
      "size": 22,
      "weight": 400,
      "letterSpacingEm": 0,
      "uppercase": false,
      "color": "textSecondary"
    },
    "button": {
      "font": "display",
      "size": 26,
      "weight": 700,
      "letterSpacingEm": 0.08,
      "uppercase": true
    },
    "buttonSecondary": {
      "font": "display",
      "size": 22,
      "weight": 600,
      "letterSpacingEm": 0.06,
      "uppercase": true
    },
    "sectionTitle": {
      "font": "mono",
      "size": 20,
      "weight": 500,
      "letterSpacingEm": 0.2,
      "uppercase": true,
      "color": "textMuted"
    },
    "viewAll": {
      "font": "mono",
      "size": 16,
      "weight": 500,
      "letterSpacingEm": 0.2,
      "uppercase": true,
      "color": "textMuted"
    },
    "tileLabel": {
      "font": "display",
      "size": 26,
      "weight": 600,
      "letterSpacingEm": 0.04,
      "uppercase": true
    },
    "tileLabelFocused": {
      "font": "display",
      "size": 30,
      "weight": 700,
      "letterSpacingEm": 0.04,
      "uppercase": true
    },
    "tag": {
      "font": "mono",
      "size": 13,
      "weight": 500,
      "letterSpacingEm": 0.16,
      "uppercase": true
    },
    "chip": {
      "font": "mono",
      "size": 16,
      "weight": 500,
      "letterSpacingEm": 0.2,
      "uppercase": true
    },
    "hint": {
      "font": "mono",
      "size": 18,
      "weight": 400,
      "letterSpacingEm": 0,
      "uppercase": false,
      "color": "textMuted"
    }
  },
  "shape": {
    "railItemRadius": 4,
    "railActiveIndicator": {
      "width": 3,
      "height": 44
    },
    "heroCardRadius": 4,
    "tileRadius": 4,
    "buttonRadius": 2,
    "buttonChamfer": 16,
    "chipRadius": 2,
    "avatarRadius": 4,
    "iconButtonRadius": 4
  },
  "focus": {
    "tileBorderWidth": 2,
    "tileBorderColor": "accent",
    "tileGlow": "0 0 36 focusGlow",
    "tileScale": 1.06,
    "brackets": {
      "size": 22,
      "width": 3,
      "offset": 10
    },
    "buttonRing": {
      "width": 2,
      "color": "focusRingButton"
    },
    "buttonGlow": "0 0 32 rgba(79,227,255,0.55)"
  },
  "style": {
    "tileShape": "square",
    "focusStyle": "brackets",
    "buttonShape": "chamfer",
    "labelCase": "upper",
    "hasBackgroundGrid": true
  },
  "motion": {
    "focusMs": 150,
    "heroCrossfadeMs": 200,
    "maxMs": 300,
    "easing": "ease-out"
  },
  "heroImage": {
    "file": "design/referenz/scifi-hero.svg"
  },
  "backgroundImage": {
    "file": "design/referenz/scifi-raster.svg"
  }
}